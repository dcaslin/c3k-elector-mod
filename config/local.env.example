# Copy to config/local.env (gitignored) to override defaults for this machine.
# Environment variables of the same name take precedence over this file.

# CK3 user data directory (contains mod/, logs/, save games/).
# CK3_USER_DIR="$HOME/Documents/Paradox Interactive/Crusader Kings III"

# CK3 install's game/ directory. Only used by scripts/validate.py for the
# vanilla path-collision check and the binary API-name check.
# CK3_GAME_DIR="$HOME/Library/Application Support/Steam/steamapps/common/Crusader Kings III/game"
